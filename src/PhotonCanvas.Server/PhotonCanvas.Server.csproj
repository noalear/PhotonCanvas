<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The remote server: lets a phone watch and run the laser through this computer (see docs/remote-api.md). No window. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PhotonCanvas.Server</RootNamespace>
    <AssemblyName>PhotonCanvas.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The phone page, served at / (works in any phone browser until the Android app exists). -->
    <EmbeddedResource Include="Web\**" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotonCanvas.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pictures and previews use SkiaSharp; on Linux its native library comes from here (the desktop app gets it with Avalonia). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotonCanvas.Core\PhotonCanvas.Core.csproj" />
    <ProjectReference Include="..\PhotonCanvas.Device\PhotonCanvas.Device.csproj" />
    <ProjectReference Include="..\PhotonCanvas.Doc\PhotonCanvas.Doc.csproj" />
    <ProjectReference Include="..\PhotonCanvas.Remote\PhotonCanvas.Remote.csproj" />
  </ItemGroup>
</Project>
