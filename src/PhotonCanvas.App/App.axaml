<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotonCanvas.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Surfaces -->
      <SolidColorBrush x:Key="Bg0" Color="#0E1014" />
      <SolidColorBrush x:Key="Bg1" Color="#15181E" />
      <SolidColorBrush x:Key="Bg2" Color="#1C2028" />
      <SolidColorBrush x:Key="Bg3" Color="#252A34" />
      <SolidColorBrush x:Key="Line" Color="#2C323D" />
      <SolidColorBrush x:Key="TextMain" Color="#E7E9EE" />
      <SolidColorBrush x:Key="TextMuted" Color="#8F98A6" />
      <SolidColorBrush x:Key="Accent" Color="#4C7BD9" />
      <SolidColorBrush x:Key="AccentDeep" Color="#2F5DB3" />
      <SolidColorBrush x:Key="AccentSoft" Color="#22324F" />
      <SolidColorBrush x:Key="AccentLine" Color="#3E5F99" />
      <SolidColorBrush x:Key="AccentHover" Color="#2A3D5F" />
      <SolidColorBrush x:Key="OnAccentSoft" Color="White" />
      <SolidColorBrush x:Key="ContextText" Color="#7FB0FF" />
      <SolidColorBrush x:Key="HudBg" Color="#E615181E" />
      <SolidColorBrush x:Key="SelBg" Color="#20304A" />
      <!-- The theme's own accent (check boxes, sliders, focus) matches ours rather than the Windows accent. -->
      <Color x:Key="SystemAccentColor">#4C7BD9</Color>
      <Color x:Key="SystemAccentColorDark1">#4170C9</Color>
      <Color x:Key="SystemAccentColorDark2">#3763B8</Color>
      <Color x:Key="SystemAccentColorDark3">#2F5DB3</Color>
      <Color x:Key="SystemAccentColorLight1">#5C88DE</Color>
      <Color x:Key="SystemAccentColorLight2">#6E96E3</Color>
      <Color x:Key="SystemAccentColorLight3">#82A4E8</Color>
      <SolidColorBrush x:Key="Warn" Color="#D6A24A" />
      <SolidColorBrush x:Key="Danger" Color="#C9554E" />
      <SolidColorBrush x:Key="Ok" Color="#4FAF83" />

      <!-- Icons: 24×24, filled (even-odd) -->
      <StreamGeometry x:Key="IcEye">M12 5C6.5 5 2.7 9.2 1.5 12c1.2 2.8 5 7 10.5 7s9.3-4.2 10.5-7C21.3 9.2 17.5 5 12 5zM12 16.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z</StreamGeometry>
      <StreamGeometry x:Key="IcEyeOff">M3.4 2 2 3.4l3.1 3.1C3.4 7.9 2.2 9.8 1.5 12c1.2 2.8 5 7 10.5 7 1.9 0 3.6-.5 5-1.3l3.6 3.6 1.4-1.4zM12 16.5A4.5 4.5 0 0 1 7.9 10.1l1.6 1.6a2.5 2.5 0 0 0 2.8 2.8l1.6 1.6c-.6.3-1.2.4-1.9.4zM12 5c5.5 0 9.3 4.2 10.5 7-.5 1.2-1.4 2.5-2.6 3.7l-3.4-3.4A4.5 4.5 0 0 0 11.7 7.5L9.4 5.2C10.2 5.1 11.1 5 12 5z</StreamGeometry>
      <StreamGeometry x:Key="IcLock">M7 10V7a5 5 0 0 1 10 0v3h1a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V11a1 1 0 0 1 1-1zM9 10h6V7a3 3 0 0 0-6 0z</StreamGeometry>
      <StreamGeometry x:Key="IcUnlock">M9 10V7a3 3 0 0 1 5.8-1h2.1A5 5 0 0 0 7 7v3H6a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V11a1 1 0 0 0-1-1z</StreamGeometry>
      <StreamGeometry x:Key="IcBolt">M13 2 4 14h6l-1 8 9-12h-6z</StreamGeometry>
      <StreamGeometry x:Key="IcPlus">M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7z</StreamGeometry>
      <StreamGeometry x:Key="IcTrash">M9 3h6l1 2h4v2H4V5h4zM6 9h12l-1 12H7z</StreamGeometry>
      <StreamGeometry x:Key="IcUp">M12 5 5 12l1.4 1.4L11 8.8V19h2V8.8l4.6 4.6L19 12z</StreamGeometry>
      <StreamGeometry x:Key="IcDown">M12 19l7-7-1.4-1.4L13 15.2V5h-2v10.2l-4.6-4.6L5 12z</StreamGeometry>
      <StreamGeometry x:Key="IcCopy">M8 3h12v12h-3v-2h1V5h-8v1H8zM4 8h12v12H4zM6 10v8h8v-8z</StreamGeometry>
      <StreamGeometry x:Key="IcMerge">M6 3h2v6l4 4 4-4V3h2v7l-5 5v6h-2v-6l-5-5z</StreamGeometry>
      <StreamGeometry x:Key="IcCursor">M5 2.5l14 8.2-6.2 1.6 3.7 7.4-2.6 1.3-3.7-7.5L5 18z</StreamGeometry>
      <StreamGeometry x:Key="IcRect">M4 5h16v14H4zM6 7v10h12V7z</StreamGeometry>
      <StreamGeometry x:Key="IcEllipse">M12 5c5 0 9 3.1 9 7s-4 7-9 7-9-3.1-9-7 4-7 9-7zM12 7c-3.9 0-7 2.2-7 5s3.1 5 7 5 7-2.2 7-5-3.1-5-7-5z</StreamGeometry>
      <StreamGeometry x:Key="IcLine">M4.4 18.2 18.2 4.4l1.4 1.4L5.8 19.6z</StreamGeometry>
      <StreamGeometry x:Key="IcPolygon">M12 2 21.5 8.9 17.9 20H6.1L2.5 8.9zM12 4.5 4.9 9.7 7.6 18h8.8l2.7-8.3z</StreamGeometry>
      <StreamGeometry x:Key="IcStar">M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 21l1.6-7L2 9.2l7.1-.6zM12 6.9l-1.6 3.7-4 .3 3 2.6-.9 3.9 3.5-2.1 3.5 2.1-.9-3.9 3-2.6-4-.3z</StreamGeometry>
      <StreamGeometry x:Key="IcPen">M3 21l1.5-5.5L15.6 4.4a2 2 0 0 1 2.8 0l1.2 1.2a2 2 0 0 1 0 2.8L8.5 19.5zM6.3 16.5l-.6 2.2 2.2-.6L17.9 8l-1.6-1.6z</StreamGeometry>
      <StreamGeometry x:Key="IcText">M4 4h16v4h-2V6h-5v12h2v2H9v-2h2V6H6v2H4z</StreamGeometry>
      <StreamGeometry x:Key="IcNodes">M3 3h6v6H3zM5 5v2h2V5zM15 15h6v6h-6zM17 17v2h2v-2zM8.4 7.6 16.4 15.6 15 17 7 9zM16 3a3 3 0 1 1 0 6 3 3 0 0 1 0-6zM16 5a1 1 0 1 0 0 2 1 1 0 0 0 0-2z</StreamGeometry>
      <StreamGeometry x:Key="IcHeart">M12 21C6 16.5 2 13 2 8.5 2 5.4 4.4 3 7.4 3c1.8 0 3.5.9 4.6 2.3C13.1 3.9 14.8 3 16.6 3 19.6 3 22 5.4 22 8.5c0 4.5-4 8-10 12.5zm0-2.5c4.8-3.7 8-6.6 8-10 0-2-1.5-3.5-3.4-3.5-1.4 0-2.7.9-3.3 2.1L12 9.4l-1.3-2.3C10.1 5.9 8.8 5 7.4 5 5.5 5 4 6.5 4 8.5c0 3.4 3.2 6.3 8 10z</StreamGeometry>
      <StreamGeometry x:Key="IcWand">M3 19.6 14.6 8l1.4 1.4L4.4 21zM17 2l.9 2.1L20 5l-2.1.9L17 8l-.9-2.1L14 5l2.1-.9zM20.5 10l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6zM10 1.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4L8 3.5l1.4-.6z</StreamGeometry>
      <StreamGeometry x:Key="IcLasso">M12 3c5 0 9 2.7 9 6.5S17 16 12 16c-1.1 0-2.2-.1-3.2-.4l-1.6 2.3c.5.9.3 2-.5 2.6-1 .7-2.3.5-3-.4s-.5-2.3.4-3l1.6-2.4C4 13.5 3 12 3 9.5 3 5.7 7 3 12 3zm0 2c-3.9 0-7 2-7 4.5S8.1 14 12 14s7-2 7-4.5S15.9 5 12 5z</StreamGeometry>
      <StreamGeometry x:Key="IcMagnet">M5 2h4v9a3 3 0 0 0 6 0V2h4v9a7 7 0 0 1-14 0z</StreamGeometry>
      <StreamGeometry x:Key="IcGrid">M3 3h18v18H3zM5 5v4h4V5zM11 5v4h2V5zM15 5v4h4V5zM5 11v2h4v-2zM11 11v2h2v-2zM15 11v2h4v-2zM5 15v4h4v-4zM11 15v4h2v-4zM15 15v4h4v-4z</StreamGeometry>
      <StreamGeometry x:Key="IcHand">M9 3.5a1.5 1.5 0 0 1 3 0V10h1V4.5a1.5 1.5 0 0 1 3 0V11h1V7.5a1.5 1.5 0 0 1 3 0V15a7 7 0 0 1-12.8 3.9L3.3 13a1.5 1.5 0 0 1 2.3-1.9L8 13.6V3.5z</StreamGeometry>
      <StreamGeometry x:Key="IcFit">M3 3h7v2H5v5H3zM14 3h7v7h-2V5h-5zM3 14h2v5h5v2H3zM19 14h2v7h-7v-2h5z</StreamGeometry>
      <StreamGeometry x:Key="IcUndo">M7.4 7H14a6 6 0 0 1 0 12H8v-2h6a4 4 0 0 0 0-8H7.4l3 3L9 13.4 3.6 8 9 2.6 10.4 4z</StreamGeometry>
      <StreamGeometry x:Key="IcRedo">M16.6 7H10a6 6 0 0 0 0 12h6v-2h-6a4 4 0 0 1 0-8h6.6l-3 3 1.4 1.4L20.4 8 15 2.6 13.6 4z</StreamGeometry>
      <StreamGeometry x:Key="IcSend">M3 20 22 12 3 4v6l12 2-12 2z</StreamGeometry>
      <StreamGeometry x:Key="IcPreview">M3 4h18v2H3zM3 9h12v2H3zM3 14h18v2H3zM3 19h8v2H3z</StreamGeometry>
      <StreamGeometry x:Key="IcCamera">M9 4h6l1.5 2H20a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3.5zM12 8.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9zM12 10.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5z</StreamGeometry>
      <StreamGeometry x:Key="IcCheck">M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z</StreamGeometry>
      <StreamGeometry x:Key="IcWarn">M12 2 1 21h22zM11 9h2v6h-2zM11 17h2v2h-2z</StreamGeometry>
      <StreamGeometry x:Key="IcLink">M10.6 13.4a1 1 0 0 0 1.4 0l4.6-4.6a3 3 0 0 0-4.2-4.2L10 7l1.4 1.4 2.4-2.4a1 1 0 0 1 1.4 1.4l-4.6 4.6a1 1 0 0 0 0 1.4zM13.4 10.6a1 1 0 0 0-1.4 0l-4.6 4.6a3 3 0 0 0 4.2 4.2L14 17l-1.4-1.4-2.4 2.4a1 1 0 0 1-1.4-1.4l4.6-4.6a1 1 0 0 0 0-1.4z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <!-- Every window (main, dialogs, tools) shows the app icon. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="/Assets/photoncanvas.ico" />
    </Style>
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Bg0}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="ToggleButton.tool">
      <Setter Property="Padding" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="ToggleButton.tool PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentDeep}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- Ribbon -->
    <Style Selector="Button.rb, ToggleButton.rb">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ToggleButton.rb:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentSoft}" />
    </Style>
    <Style Selector="ToggleButton.rb:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
    </Style>
    <Style Selector="Button.rb:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.rb:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="ToggleButton.rbtab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
    <Style Selector="ToggleButton.rbtab:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
    </Style>
    <Style Selector="ToggleButton.rbtab:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
    </Style>
    <Style Selector="ToggleButton.rbtab.context">
      <Setter Property="Foreground" Value="{DynamicResource ContextText}" />
    </Style>

    <!-- Segmented choices (layer mode, laser) -->
    <Style Selector="ToggleButton.seg">
      <Setter Property="Background" Value="{DynamicResource Bg1}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="4,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.seg.first">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="ToggleButton.seg.last">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="ToggleButton.seg:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentSoft}" />
    </Style>
    <Style Selector="ToggleButton.seg:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentSoft}" />
    </Style>

    <!-- Floating panels over the work area -->
    <Style Selector="Border.hud">
      <Setter Property="Background" Value="{DynamicResource HudBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BoxShadow" Value="0 4 18 0 #66000000" />
    </Style>
    <Style Selector="Button.chip, ToggleButton.chip">
      <Setter Property="Background" Value="{DynamicResource Bg2}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
