<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:PhotonCanvas.App"
        x:Class="PhotonCanvas.App.MainWindow"
        Title="PhotonCanvas"
        Width="1500" Height="920" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- Commands -->
    <ContentControl x:Name="RibbonHost" DockPanel.Dock="Top" />

    <!-- Status line -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg0}" Padding="12,2">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <Button x:Name="UpdateChip" IsVisible="False" FontSize="11" Padding="8,0" MinHeight="0" VerticalAlignment="Center" Classes="primary" />
        <TextBlock x:Name="CursorText" Classes="muted" FontSize="11" MinWidth="150" />
        <TextBlock x:Name="ZoomText" Classes="muted" FontSize="11" MinWidth="50" />
        <TextBlock x:Name="StatusText" Classes="muted" FontSize="11" />
      </StackPanel>
    </Border>

    <Grid x:Name="MainGrid" ColumnDefinitions="280,4,*,4,300">
      <!-- The side panels (layers, selection, layer settings): movable, see Docking -->
      <ContentControl x:Name="LeftDock" Grid.Column="0" />
      <GridSplitter x:Name="LeftSplit" Grid.Column="1" Background="{DynamicResource Line}" ResizeDirection="Columns" />

      <!-- Work area -->
      <DockPanel Grid.Column="2">
        <Border x:Name="ToolOptions" DockPanel.Dock="Top" Background="{DynamicResource Bg1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,4" IsVisible="False">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolMethodGroup" Orientation="Horizontal" Spacing="6" IsVisible="False" ToolTip.Tip="How this tool draws: by dragging a box, or click by click as in a CAD program (centre and radius, 3 points, touching other shapes…)">
              <TextBlock Text="Draw by" VerticalAlignment="Center" Classes="muted" />
              <ComboBox x:Name="ToolMethod" MinWidth="240" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolOptionsLabel" VerticalAlignment="Center" Classes="muted" />
            <NumericUpDown DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolCorners" Minimum="3" Maximum="64" Increment="1" FormatString="0" Width="110" />
            <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolInnerLabel" Text="Inner size %" VerticalAlignment="Center" Classes="muted" />
            <NumericUpDown DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolInner" Minimum="5" Maximum="95" Increment="5" FormatString="0" Width="110" />
            <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolRadiusGroup" Orientation="Horizontal" Spacing="6" IsVisible="False" ToolTip.Tip="The radius of the circle that touches the two lines or circles you click.">
              <TextBlock Text="Radius mm" VerticalAlignment="Center" Classes="muted" />
              <NumericUpDown x:Name="ToolRadius" Minimum="0.01" Maximum="2000" Increment="1" FormatString="0.##" Width="120" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="ToolCentrelineGroup" Orientation="Horizontal" Spacing="10" IsVisible="False">
              <CheckBox x:Name="ToolMarkCentrelines" Content="Mark centrelines" VerticalAlignment="Center" ToolTip.Tip="Off: centrelines go on the Centrelines layer, which isn't marked (they're there to line things up with). On: they go on the layer you're drawing on and are marked like any line." />
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="How far centrelines and centre marks run past the lines, circle or shape they're drawn on.">
                <TextBlock Text="Overshoot mm" VerticalAlignment="Center" Classes="muted" />
                <NumericUpDown x:Name="ToolOvershoot" Minimum="0" Maximum="100" Increment="0.5" FormatString="0.##" Width="110" />
              </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Margin="0,0,10,0" x:Name="WandPanel" Orientation="Horizontal" Spacing="6" IsVisible="False">
              <StackPanel x:Name="WandTolGroup" Orientation="Horizontal" Spacing="6" ToolTip.Tip="How different a colour can be and still count as the piece. Raise it if the outline stops short; lower it if it spills onto the bed.">
                <TextBlock Text="Tolerance" VerticalAlignment="Center" Classes="muted" />
                <Slider x:Name="WandTolerance" Minimum="1" Maximum="100" Width="90" VerticalAlignment="Center" />
                <TextBlock x:Name="WandToleranceText" MinWidth="22" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="0 follows every step of the edge; higher values give smoother, simpler outlines.">
                <TextBlock Text="Smoothness" VerticalAlignment="Center" Classes="muted" />
                <Slider x:Name="WandSmoothness" Minimum="0" Maximum="10" Width="80" VerticalAlignment="Center" />
                <TextBlock x:Name="WandSmoothnessText" MinWidth="22" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="Bends sharper than this stay as corners; gentler ones become curves. 0 = straight lines only.">
                <TextBlock Text="Corners" VerticalAlignment="Center" Classes="muted" />
                <Slider x:Name="WandCorners" Minimum="0" Maximum="180" Width="80" VerticalAlignment="Center" />
                <TextBlock x:Name="WandCornersText" MinWidth="30" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel x:Name="WandIgnoreGroup" Orientation="Horizontal" Spacing="6" ToolTip.Tip="Specks and holes smaller than this (mm²) are left out: knots, burn marks, dust.">
                <TextBlock Text="Ignore under" VerticalAlignment="Center" Classes="muted" />
                <Slider x:Name="WandIgnore" Minimum="0" Maximum="50" Width="80" VerticalAlignment="Center" />
                <TextBlock x:Name="WandIgnoreText" MinWidth="44" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ToolHint" VerticalAlignment="Center" Classes="hint" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
        <!-- The project's pages -->
        <ContentControl x:Name="PagesHost" DockPanel.Dock="Top" />
        <!-- The job, always in view under the work area -->
        <ContentControl x:Name="JobHost" DockPanel.Dock="Bottom" />
        <Panel>
          <app:CanvasView x:Name="Canvas" />
          <!-- Bottom-right corner: the close-up camera (when open) above the zoom buttons. -->
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <ContentControl x:Name="CanvasOverlay" HorizontalAlignment="Right" />
            <ContentControl x:Name="ZoomHost" HorizontalAlignment="Right" />
          </StackPanel>
        </Panel>
      </DockPanel>

      <GridSplitter x:Name="RightSplit" Grid.Column="3" Background="{DynamicResource Line}" ResizeDirection="Columns" />
      <ContentControl x:Name="RightDock" Grid.Column="4" />
    </Grid>
  </DockPanel>
</Window>
