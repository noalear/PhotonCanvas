<Project Sdk="Microsoft.NET.Sdk">
  <!-- What the phone and the remote server say to each other (docs/remote-api.md), the phone's client for it, and a demo machine. No other dependencies: it goes into the Android app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PhotonCanvas.Remote</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhotonCanvas.Tests" />
  </ItemGroup>
</Project>
