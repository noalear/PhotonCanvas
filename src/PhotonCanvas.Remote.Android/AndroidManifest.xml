<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Talking to PhotonCanvas on the user's computer. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- A buzz when a job ends, a long one for the machine's alarms. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- No backup: the computer's access code stays on this phone. -->
  <application
      android:label="PhotonCanvas Remote"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:supportsRtl="true"
      android:networkSecurityConfig="@xml/network_security_config">
    <!-- Have Play services fetch the QR scanner when the app is installed, not on first use. -->
    <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode_ui" />
  </application>
</manifest>
