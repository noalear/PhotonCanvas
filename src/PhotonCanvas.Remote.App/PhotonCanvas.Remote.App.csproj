<Project Sdk="Microsoft.NET.Sdk">
  <!-- PhotonCanvas Remote: the phone app's screens (Avalonia), shared by the Android app and a desktop window for trying it out. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PhotonCanvas.Remote.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotonCanvas.Remote\PhotonCanvas.Remote.csproj" />
  </ItemGroup>
</Project>
