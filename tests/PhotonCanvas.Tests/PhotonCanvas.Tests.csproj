<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The add-ons below are not listed in the solution; build them in this build's configuration. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- For the program's own types that use Avalonia's (colours in the 3D views' painter). -->
    <PackageReference Include="Avalonia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotonCanvas.Core\PhotonCanvas.Core.csproj" />
    <ProjectReference Include="..\..\src\PhotonCanvas.Device\PhotonCanvas.Device.csproj" />
    <ProjectReference Include="..\..\src\PhotonCanvas.Doc\PhotonCanvas.Doc.csproj" />
    <ProjectReference Include="..\..\src\PhotonCanvas.Server\PhotonCanvas.Server.csproj" />
    <ProjectReference Include="..\..\src\PhotonCanvas.Remote\PhotonCanvas.Remote.csproj" />
    <ProjectReference Include="..\..\src\PhotonCanvas.Remote.App\PhotonCanvas.Remote.App.csproj" />
    <!-- Every add-on, found by folder, so a new add-on never edits this file. -->
    <ProjectReference Include="..\..\src\Addons\*\*.csproj" />
  </ItemGroup>

</Project>