<Project Sdk="Microsoft.NET.Sdk">
  <!-- The help guide's screenshots, and a check that walks every tutorial. Run it from the repository root (see Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <ProjectReference Include="..\..\src\PhotonCanvas.App\PhotonCanvas.App.csproj" />
    <!-- Every add-on, found by folder, so a new add-on never edits this file (pictures go in each add-on's help/images). -->
    <ProjectReference Include="..\..\src\Addons\*\*.csproj" />
  </ItemGroup>
</Project>
