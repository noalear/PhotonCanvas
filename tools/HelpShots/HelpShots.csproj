    <ProjectReference Include="..\..\src\PhotonCanvas.App\PhotonCanvas.App.csproj" />
    <!-- Add-ons whose windows are photographed (their pictures go in their own help/images). -->
    <ProjectReference Include="..\..\src\Addons\DepthOutlines\PhotonCanvas.Addon.DepthOutlines.csproj" />
    <ProjectReference Include="..\..\src\Addons\Warp\PhotonCanvas.Addon.Warp.csproj" />
    <ProjectReference Include="..\..\src\Addons\Slicer\PhotonCanvas.Addon.Slicer.csproj" />
    <ProjectReference Include="..\..\src\Addons\Relief\PhotonCanvas.Addon.Relief.csproj" />
  </ItemGroup>
</Project>
